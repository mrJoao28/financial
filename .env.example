# Market data
NEXT_PUBLIC_FINNHUB_API_KEY=

# Authentication
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# In Vercel, set this to https://financial-8in8.vercel.app
# or leave unset to use Vercel's deployment URL automatically.
BETTER_AUTH_URL=http://localhost:3000

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only; leave unset in Vercel.
INNGEST_DEV=
# AI
AI_API_KEY=

# Database: MongoDB Atlas connection URI, including the database name.
MONGODB_URI=
# DATABASE_URL is also accepted if it contains a mongodb:// or mongodb+srv:// URI.
